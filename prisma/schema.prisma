// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model stores {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  password                   String?
  theme_color                String?
  last_incentive_calculation DateTime? @db.Timestamptz
  sellers                    sellers[]
  goals                      goals?
  history                    SellerHistory[]
}

model sellers {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String  @db.VarChar(255)
  password           String? @db.VarChar(255)
  avatar_id          String? @db.VarChar(50)
  vendas             Decimal? @default(0) @db.Decimal(10, 2)
  pa                 Decimal? @default(0) @db.Decimal(5, 2)
  ticket_medio       Decimal? @default(0) @db.Decimal(10, 2)
  corridinha_diaria  Decimal? @default(0) @db.Decimal(10, 2)
  store_id           String  @db.Uuid
  store              stores  @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model goals {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id                   String   @unique @db.Uuid
  store                      stores   @relation(fields: [store_id], references: [id], onDelete: Cascade)
  metaMinha                  Int?     @default(0) @map("metaMinha")
  metaMinhaPrize             Int?     @default(0) @map("metaMinhaPrize")
  meta                       Int?     @default(0)
  metaPrize                  Int?     @default(0) @map("metaPrize")
  metona                     Int?     @default(0)
  metonaPrize                Int?     @default(0) @map("metonaPrize")
  metaLendaria               Int?     @default(0) @map("metaLendaria")
  legendariaBonusValorVenda  Int?     @default(0) @map("legendariaBonusValorVenda")
  legendariaBonusValorPremio Int?     @default(0) @map("legendariaBonusValorPremio")
  performanceBonusEnabled    Boolean? @default(false) @map("performanceBonusEnabled")
  paGoal1                    Float?   @default(0) @map("paGoal1")
  paPrize1                   Int?     @default(0) @map("paPrize1")
  paGoal2                    Float?   @default(0) @map("paGoal2")
  paPrize2                   Int?     @default(0) @map("paPrize2")
  paGoal3                    Float?   @default(0) @map("paGoal3")
  paPrize3                   Int?     @default(0) @map("paPrize3")
  paGoal4                    Float?   @default(0) @map("paGoal4")
  paPrize4                   Int?     @default(0) @map("paPrize4")
  ticketMedioGoal1           Int?     @default(0) @map("ticketMedioGoal1")
  ticketMedioPrize1          Int?     @default(0) @map("ticketMedioPrize1")
  ticketMedioGoal2           Int?     @default(0) @map("ticketMedioGoal2")
  ticketMedioPrize2          Int?     @default(0) @map("ticketMedioPrize2")
  ticketMedioGoal3           Int?     @default(0) @map("ticketMedioGoal3")
  ticketMedioPrize3          Int?     @default(0) @map("ticketMedioPrize3")
  ticketMedioGoal4           Int?     @default(0) @map("ticketMedioGoal4")
  ticketMedioPrize4          Int?     @default(0) @map("ticketMedioPrize4")
  corridinhaEnabled          Boolean? @default(false) @map("corridinhaEnabled")
}

model app_config {
  key   String @id @db.VarChar(255)
  value String?
}

model SellerHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period       String   @db.VarChar(100)
  createdAt    DateTime @default(now())

  // Snapshot data
  vendas       Decimal  @default(0) @db.Decimal(10, 2)
  pa           Decimal  @default(0) @db.Decimal(5, 2)
  ticket_medio Decimal  @default(0) @db.Decimal(10, 2)
  total_prize  Decimal  @default(0) @db.Decimal(10, 2)
  
  // Denormalized data for resilience
  seller_id    String   @db.Uuid
  seller_name  String

  // Relation to the store
  store_id     String   @db.Uuid
  store        stores   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, createdAt(sort: Desc)])
  @@index([seller_id])
}

// Créditos de giros por vendedor
model PrizeWheelCredits {
  id        String   @id @default(cuid())
  storeId   String
  sellerId  String
  credits   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, sellerId])
  @@map("prize_wheel_credits")
}

// Configurações da roleta por loja
model PrizeWheelSettings {
  id        String               @id @default(cuid())
  storeId   String               @unique
  isActive  Boolean              @default(true)
  segments  PrizeWheelSegment[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@map("prize_wheel_settings")
}

// Segmentos/prêmios da roleta
model PrizeWheelSegment {
  id          String              @id @default(cuid())
  settingsId  String
  settings    PrizeWheelSettings  @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  
  // Configurações do prêmio
  label       String              // "R$ 10,00", "Perfume Natura", "Vale 20% Off"
  type        String              // "money", "product", "voucher"
  value       Decimal?            @db.Decimal(10,2) // Valor monetário
  description String?             // Descrição detalhada
  
  // Configurações visuais
  color       String              @default("#3B82F6")
  weight      Int                 @default(10) // Peso para probabilidade
  position    Int                 // Posição na roleta (0-7)
  isActive    Boolean             @default(true)
  
  // Relacionamentos
  spins       PrizeWheelSpins[]
  
  @@map("prize_wheel_segments")
}

// Histórico de giros realizados
model PrizeWheelSpins {
  id          String            @id @default(cuid())
  storeId     String
  sellerId    String
  grantedBy   String            // ID do gerente que concedeu
  
  // Prêmio sorteado
  segmentId   String
  segment     PrizeWheelSegment @relation(fields: [segmentId], references: [id])
  
  // Status e controle
  status      String            @default("pending") // "pending", "paid", "delivered"
  notes       String?           // Observações
  
  // Timestamps
  createdAt   DateTime          @default(now())
  claimedAt   DateTime?
  paidAt      DateTime?
  
  @@map("prize_wheel_spins")
}
