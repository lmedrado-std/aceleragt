generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model stores {
  id                         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  theme_color                String?
  password                   String?
  last_incentive_calculation DateTime?       @db.Timestamp(6)
  SellerHistory              SellerHistory[]
  goals                      goals?
  sellers                    sellers[]
}

model sellers {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id          String    @db.Uuid
  name              String    @db.VarChar(255)
  password          String    @db.VarChar(255)
  avatar_id         String    @db.VarChar(50)
  vendas            Decimal?  @default(0) @db.Decimal(10, 2)
  pa                Decimal?  @default(0) @db.Decimal(10, 2)
  ticket_medio      Decimal?  @default(0) @db.Decimal(10, 2)
  corridinha_diaria Decimal?  @default(0) @db.Decimal(10, 2)
  last_viewed_at    DateTime? @db.Timestamptz(6)
  view_count        Int?      @default(0)
  stores            stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model goals {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id                   String   @unique(map: "goals_store_id_unique") @db.Uuid
  metaMinha                  Int?
  metaMinhaPrize             Int?
  meta                       Int?
  metaPrize                  Int?
  metona                     Int?
  metonaPrize                Int?
  metaLendaria               Int?
  legendariaBonusValorVenda  Int?
  legendariaBonusValorPremio Int?
  paGoal1                    Float?   @db.Real
  paPrize1                   Int?
  paGoal2                    Float?   @db.Real
  paPrize2                   Int?
  paGoal3                    Float?   @db.Real
  paPrize3                   Int?
  paGoal4                    Float?   @db.Real
  paPrize4                   Int?
  ticketMedioGoal1           Int?
  ticketMedioPrize1          Int?
  ticketMedioGoal2           Int?
  ticketMedioPrize2          Int?
  ticketMedioGoal3           Int?
  ticketMedioPrize3          Int?
  ticketMedioGoal4           Int?
  ticketMedioPrize4          Int?
  performanceBonusEnabled    Boolean? @default(false)
  corridinhaenabled          Boolean? @default(false)
  corridinhaEnabled          Boolean? @default(false)
  store                      stores   @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model SellerHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period       String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  vendas       Decimal  @default(0) @db.Decimal(10, 2)
  pa           Decimal  @default(0) @db.Decimal(5, 2)
  ticket_medio Decimal  @default(0) @db.Decimal(10, 2)
  total_prize  Decimal  @default(0) @db.Decimal(10, 2)
  seller_id    String   @db.Uuid
  seller_name  String   @db.VarChar(255)
  store_id     String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  stores       stores   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([seller_id])
  @@index([store_id, createdAt(sort: Desc)])
}

model app_config {
  key   String @id
  value String
}

model prize_wheel_settings {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  store_id             String                 @unique @db.VarChar(36)
  is_active            Boolean?               @default(true)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @updatedAt @db.Timestamp(6)
  prize_wheel_segments prize_wheel_segments[]
}

model prize_wheel_segments {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  settings_id       String               @db.VarChar(36)
  label             String               @db.VarChar(100)
  type              String               @db.VarChar(32)
  value             Decimal?             @db.Decimal(10, 2)
  description       String?              @db.VarChar(255)
  color             String?              @default("#3B82F6") @db.VarChar(32)
  weight            Int?                 @default(10)
  position          Int
  is_active         Boolean?             @default(true)
  settings          prize_wheel_settings @relation(fields: [settings_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prize_wheel_spins prize_wheel_spins[]
}

model prize_wheel_credits {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  store_id   String    @db.VarChar(36)
  seller_id  String    @db.VarChar(36)
  credits    Int       @default(0)
  updated_at DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([store_id, seller_id], name: "store_id_seller_id")
}

model prize_wheel_spins {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  store_id             String               @db.VarChar(36)
  seller_id            String               @db.VarChar(36)
  granted_by           String?              @db.VarChar(36)
  segment_id           String               @db.VarChar(36)
  status               String?              @default("pending") @db.VarChar(16)
  notes                String?              @db.VarChar(255)
  created_at           DateTime?            @default(now()) @db.Timestamp(6)
  claimed_at           DateTime?            @db.Timestamp(6)
  paid_at              DateTime?            @db.Timestamp(6)
  prize_wheel_segments prize_wheel_segments @relation(fields: [segment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model loja_restricao {
  id          Int       @id @default(autoincrement())
  loja_id     String    @db.Uuid
  modo        String    @default("OU") @db.VarChar(10)
  criado_em   DateTime? @default(now()) @db.Timestamptz(6)
  alterado_em DateTime? @default(now()) @db.Timestamptz(6)
}

model loja_area_permitida {
  id        Int     @id @default(autoincrement())
  loja_id   String  @db.Uuid
  nome      String  @db.VarChar(128)
  latitude  Float
  longitude Float
  raio      Int
  descricao String?
  ativo     Boolean @default(true)
}

model loja_wifi_permitido {
  id        Int     @id @default(autoincrement())
  loja_id   String  @db.Uuid
  nome      String  @db.VarChar(128)
  ssid      String  @db.VarChar(128)
  descricao String?
  ativo     Boolean @default(true)
}

model admins {
  id       String @id
  password String
}

model incentives {
  id          Int      @id @default(autoincrement())
  store_id    Int?
  description String
  amount      Decimal? @db.Decimal
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
