generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model stores {
  id                         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  theme_color                String?
  password                   String?
  last_incentive_calculation DateTime?       @db.Timestamp(6)
  history                    SellerHistory[]
  goals                      goals?
  sellers                    sellers[]
}

model sellers {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id          String    @db.Uuid
  name              String    @db.VarChar(255)
  password          String    @db.VarChar(255)
  avatar_id         String    @db.VarChar(50)
  vendas            Decimal?  @default(0) @db.Decimal(10, 2)
  pa                Decimal?  @default(0) @db.Decimal(10, 2)
  ticket_medio      Decimal?  @default(0) @db.Decimal(10, 2)
  corridinha_diaria Decimal?  @default(0) @db.Decimal(10, 2)
  last_viewed_at    DateTime? @db.Timestamptz(6)
  view_count        Int?      @default(0)
  store             stores    @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model goals {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id                   String   @unique(map: "goals_store_id_unique") @db.Uuid
  metaMinha                  Int?     @map("metaMinha")
  metaMinhaPrize             Int?     @map("metaMinhaPrize")
  meta                       Int?
  metaPrize                  Int?     @map("metaPrize")
  metona                     Int?
  metonaPrize                Int?     @map("metonaPrize")
  metaLendaria               Int?     @map("metaLendaria")
  legendariaBonusValorVenda  Int?     @map("legendariaBonusValorVenda")
  legendariaBonusValorPremio Int?     @map("legendariaBonusValorPremio")
  paGoal1                    Float?   @map("paGoal1") @db.Real
  paPrize1                   Int?     @map("paPrize1")
  paGoal2                    Float?   @map("paGoal2") @db.Real
  paPrize2                   Int?     @map("paPrize2")
  paGoal3                    Float?   @map("paGoal3") @db.Real
  paPrize3                   Int?     @map("paPrize3")
  paGoal4                    Float?   @map("paGoal4") @db.Real
  paPrize4                   Int?     @map("paPrize4")
  ticketMedioGoal1           Int?     @map("ticketMedioGoal1")
  ticketMedioPrize1          Int?     @map("ticketMedioPrize1")
  ticketMedioGoal2           Int?     @map("ticketMedioGoal2")
  ticketMedioPrize2          Int?     @map("ticketMedioPrize2")
  ticketMedioGoal3           Int?     @map("ticketMedioGoal3")
  ticketMedioPrize3          Int?     @map("ticketMedioPrize3")
  ticketMedioGoal4           Int?     @map("ticketMedioGoal4")
  ticketMedioPrize4          Int?     @map("ticketMedioPrize4")
  performanceBonusEnabled    Boolean? @default(false) @map("performanceBonusEnabled")
  corridinhaenabled          Boolean? @default(false)
  corridinhaEnabled          Boolean? @default(false) @map("corridinhaEnabled")
  store                      stores   @relation(fields: [store_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model app_config {
  key   String @id
  value String
}

model SellerHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  period       String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  vendas       Decimal  @default(0) @db.Decimal(10, 2)
  pa           Decimal  @default(0) @db.Decimal(5, 2)
  ticket_medio Decimal  @default(0) @db.Decimal(10, 2)
  total_prize  Decimal  @default(0) @db.Decimal(10, 2)
  seller_id    String   @db.Uuid
  seller_name  String   @db.VarChar(255)
  store_id     String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  store        stores   @relation(fields: [store_id], references: [id], onDelete: Cascade)

  @@index([store_id, createdAt(sort: Desc)])
  @@index([seller_id])
}

model admins {
  id       String @id
  password String
}

model incentives {
  id          Int      @id @default(autoincrement())
  store_id    Int?
  description String
  amount      Decimal? @db.Decimal
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model PrizeWheelCredits {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  store_id   String    @db.VarChar(36)
  seller_id  String    @db.VarChar(36)
  credits    Int       @default(0)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@unique([store_id, seller_id])
  @@map("prize_wheel_credits")
}

model PrizeWheelSettings {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  store_id             String              @unique @db.VarChar(36)
  is_active            Boolean?            @default(true)
  created_at           DateTime?           @default(now()) @db.Timestamp(6)
  updated_at           DateTime?           @default(now()) @db.Timestamp(6)
  prize_wheel_segments PrizeWheelSegment[]

  @@map("prize_wheel_settings")
}

model PrizeWheelSegment {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  settings_id          String             @db.VarChar(36)
  label                String             @db.VarChar(100)
  type                 String             @db.VarChar(32)
  value                Decimal?           @db.Decimal(10, 2)
  description          String?            @db.VarChar(255)
  color                String?            @default("#3B82F6") @db.VarChar(32)
  weight               Int?               @default(10)
  position             Int
  is_active            Boolean?           @default(true)
  prize_wheel_settings PrizeWheelSettings @relation(fields: [settings_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  prize_wheel_spins    PrizeWheelSpins[]

  @@map("prize_wheel_segments")
}

model PrizeWheelSpins {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  store_id             String            @db.VarChar(36)
  seller_id            String            @db.VarChar(36)
  granted_by           String?           @db.VarChar(36)
  segment_id           String            @db.VarChar(36)
  status               String?           @default("pending") @db.VarChar(16)
  notes                String?           @db.VarChar(255)
  created_at           DateTime?         @default(now()) @db.Timestamp(6)
  claimed_at           DateTime?         @db.Timestamp(6)
  paid_at              DateTime?         @db.Timestamp(6)
  prize_wheel_segments PrizeWheelSegment @relation(fields: [segment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("prize_wheel_spins")
}

model loja_area_permitida {
  id        Int     @id @default(autoincrement())
  loja_id   String  @db.Uuid
  nome      String  @db.VarChar(128)
  latitude  Float
  longitude Float
  raio      Int
  descricao String?
  ativo     Boolean @default(true)
}

model loja_restricao {
  id          Int       @id @default(autoincrement())
  loja_id     String    @db.Uuid
  modo        String    @default("OU") @db.VarChar(10)
  criado_em   DateTime? @default(now()) @db.Timestamptz(6)
  alterado_em DateTime? @default(now()) @db.Timestamptz(6)
}

model loja_wifi_permitido {
  id        Int     @id @default(autoincrement())
  loja_id   String  @db.Uuid
  nome      String  @db.VarChar(128)
  ssid      String  @db.VarChar(128)
  descricao String?
  ativo     Boolean @default(true)
}
